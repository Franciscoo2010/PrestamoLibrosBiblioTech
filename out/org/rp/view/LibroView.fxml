<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.rp.controller.LibroController"
            style="-fx-background-color: #1a1a2e;">

    <!-- HEADER -->
    <top>
        <HBox style="-fx-background-color: #16213e; -fx-padding: 15;" alignment="CENTER_LEFT" spacing="10">
            <Label text="📚 BiblioTech" style="-fx-text-fill: #e94560; -fx-font-size: 22px; -fx-font-weight: bold;" />
            <Label text="— Gestión de Libros" style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;" />
            <Button fx:id="btnPrestamos" text="Préstamos" onAction="#handlePrestamos" />
            <Button text="Cerrar sesión" onAction="#handleCerrarSesion" />
        </HBox>
    </top>

    <!-- FORM -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #16213e; -fx-padding: 20;" prefWidth="260">
            <Label text="Título:" style="-fx-text-fill: #aaaaaa;" />
            <TextField fx:id="txtTitulo" promptText="Título del libro"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-border-color: #e94560; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;" />

            <Label text="Autor:" style="-fx-text-fill: #aaaaaa;" />
            <TextField fx:id="txtAutor" promptText="Autor"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-border-color: #e94560; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;" />

            <Label text="ISBN:" style="-fx-text-fill: #aaaaaa;" />
            <TextField fx:id="txtIsbn" promptText="ISBN"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-border-color: #e94560; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;" />

            <Label text="Stock:" style="-fx-text-fill: #aaaaaa;" />
            <TextField fx:id="txtStock" promptText="Stock disponible"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-border-color: #e94560; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;" />

            <Label text="Año de publicación:" style="-fx-text-fill: #aaaaaa;" />
            <TextField fx:id="txtAnio" promptText="Año"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-border-color: #e94560; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;" />

            <Button fx:id="btnInsertar" text="➕ Insertar" onAction="#handleInsertar" maxWidth="Infinity"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" />
            <Button fx:id="btnActualizar" text="✏ Actualizar" onAction="#handleActualizar" maxWidth="Infinity"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" />
            <Button fx:id="btnEliminar" text="🗑 Eliminar" onAction="#handleEliminar" maxWidth="Infinity"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" />
            <Button text="🧹 Limpiar" onAction="#handleLimpiar" maxWidth="Infinity"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" />
        </VBox>
    </left>

    <!-- TABLE -->
    <center>
        <VBox style="-fx-padding: 20;" spacing="10">
            <Label text="Catálogo de Libros" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <TableView fx:id="tblLibros" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="200" />
                    <TableColumn fx:id="colAutor" text="Autor" prefWidth="150" />
                    <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="120" />
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="70" />
                    <TableColumn fx:id="colAnio" text="Año" prefWidth="70" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
