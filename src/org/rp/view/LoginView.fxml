<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.rp.controller.LoginController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: #1a1a2e; -fx-padding: 60;">

    <Label text="BiblioTech" style="-fx-text-fill: #e94560; -fx-font-size: 32px; -fx-font-weight: bold;" />
    <Label text="Préstamo de Libros" style="-fx-text-fill: #ffffff; -fx-font-size: 14px;" />

    <VBox spacing="8" maxWidth="320">
        <Label text="Correo electrónico:" style="-fx-text-fill: #aaaaaa;" />
        <TextField fx:id="txtEmail" promptText="usuario@bibliotech.com"
                   style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-border-color: #e94560; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />

        <Label text="Contraseña:" style="-fx-text-fill: #aaaaaa;" />
        <PasswordField fx:id="txtPassword" promptText="••••••••"
                       style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-border-color: #e94560; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />

        <Button text="INICIAR SESIÓN" onAction="#handleLogin"
                maxWidth="Infinity"
                style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10; -fx-cursor: hand; -fx-background-radius: 4;" />
    </VBox>
</VBox>
