<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.rp.controller.PrestamoController"
            style="-fx-background-color: #1a1a2e;">

    <top>
        <HBox style="-fx-background-color: #16213e; -fx-padding: 15;" alignment="CENTER_LEFT" spacing="10">
            <Label text="📚 BiblioTech" style="-fx-text-fill: #e94560; -fx-font-size: 22px; -fx-font-weight: bold;" />
            <Label text="— Gestión de Préstamos" style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;" />
        </HBox>
    </top>

    <left>
        <VBox spacing="12" style="-fx-background-color: #16213e; -fx-padding: 20;" prefWidth="280">
            <Label text="Registrar Préstamo" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />

            <Label text="Usuario / Socio:" style="-fx-text-fill: #aaaaaa;" />
            <ComboBox fx:id="cmbUsuario" maxWidth="Infinity"
                      style="-fx-background-color: #0f3460; -fx-border-color: #e94560; -fx-border-radius: 4;" />

            <Label text="Libro:" style="-fx-text-fill: #aaaaaa;" />
            <ComboBox fx:id="cmbLibro" maxWidth="Infinity"
                      style="-fx-background-color: #0f3460; -fx-border-color: #e94560; -fx-border-radius: 4;" />

            <Button text="📖 Registrar Préstamo" onAction="#handleRegistrarPrestamo" maxWidth="Infinity"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" />

            <Button text="✅ Devolver Libro" onAction="#handleDevolver" maxWidth="Infinity"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" />
        </VBox>
    </left>

    <center>
        <VBox style="-fx-padding: 20;" spacing="10">
            <Label text="Historial de Préstamos" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <TableView fx:id="tblPrestamos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                    <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="150" />
                    <TableColumn fx:id="colLibro" text="Libro" prefWidth="180" />
                    <TableColumn fx:id="colFecha" text="Fecha Préstamo" prefWidth="120" />
                    <TableColumn fx:id="colDevolucion" text="Devolución" prefWidth="120" />
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="90" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>